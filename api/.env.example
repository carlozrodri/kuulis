# Copy to .env for local development. In Coolify these are set per environment.
APP_ENV=local
SECRET_KEY=change-me-to-a-long-random-string-of-64-chars
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kuulis
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
ALLOWED_HOSTS=*

# Storage (S3 compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
STORAGE_PREFIX=local

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Kuulis <no-reply@top8.uk>
EMAIL_ENABLED=false

# Push (Expo). Optional access token for enhanced security.
EXPO_ACCESS_TOKEN=

# Sentry (installed, disabled for now)
SENTRY_ENABLED=false
SENTRY_DSN=

# First admin user created on deploy (idempotent)
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=

# Process tuning
WEB_CONCURRENCY=4
WORKER_CONCURRENCY=2
