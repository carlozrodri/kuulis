// Public website on Cloudflare Workers (docs/deployment.md → Web pública en Cloudflare). Built with
// `pnpm build:cloudflare`; the Docker image (Coolify) keeps using `pnpm build`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuulis",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".output/public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Pull requests get a preview build (`wrangler preview`), which needs this block even when empty.
  "previews": {},
  // The NUXT_* variables live in the Cloudflare dashboard (they differ while the site still points at QA), so a
  // deploy must not wipe them.
  "keep_vars": true
}
