  "scripts": {
    "start": "expo start",
    "start:qa": "APP_ENV=qa expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "npx expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/test-utils/iconStub.js",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test-utils/",
      "/.maestro/"
    ],
    "setupFiles": [
      "<rootDir>/test-utils/setup.js"
    ],
    "testTimeout": 20000
  }
