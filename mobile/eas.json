{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "local"
      }
    },
    "qa": {
      "distribution": "internal",
      "channel": "qa",
      "env": {
        "APP_ENV": "qa"
      },
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "qa-dev": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "qa"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "play": {
      "extends": "production",
      "env": {
        "APP_ENV": "production",
        "APP_STORE": "play",
        "API_URL": "https://kuulis-qa.top8.uk/api/v1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
