# Local development. The dev server proxies /api to http://localhost:8000.
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_APP_ENV=local
# Optional: raster tile server for the ride maps (defaults to OpenStreetMap's standard tiles).
# NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NUXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
